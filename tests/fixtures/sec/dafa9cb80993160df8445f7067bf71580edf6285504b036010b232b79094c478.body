      id="Narr_C_tFmEIyhECXpWv5B1cPsw"
      unitRef="Unit_Standard_USD_w_6nirPaRk6QIxER_bEmmw">165000</us-gaap:RestrictedCashAndCashEquivalentsAtCarryingValue>
